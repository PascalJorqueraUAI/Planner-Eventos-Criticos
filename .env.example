# GEMINI_API_KEY: clave de la API de Gemini (opcional). Sin ella, la extracción de
# comprobantes es solo local (texto) y los datos se completan a mano.
# AI Studio la inyecta en tiempo de ejecución desde el panel de Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: modelo a usar. Verifica el identificador vigente en
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL="gemini-3.6-flash"

# GEMINI_TRATAMIENTO_AUTORIZADO: interruptor de cumplimiento (Ley 19.628 / Ley 21.719).
# Aunque haya clave, Gemini NO se usa hasta que esto valga "si". Actívalo solo cuando:
#   1. El proyecto de Google Cloud tenga facturación activa (plan pagado: Google actúa como
#      encargado del tratamiento y no usa los datos para entrenar; el plan gratuito sí los usa).
#   2. Esté aceptado el anexo de procesamiento de datos (DPA) de Google.
#   3. Cobgestion haya definido la base legal de la transferencia internacional e informado
#      el tratamiento en su política de privacidad.
GEMINI_TRATAMIENTO_AUTORIZADO="no"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
